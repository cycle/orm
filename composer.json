{
    "name": "cycle/orm",
    "type": "library",
    "license": "MIT",
    "description": "PHP DataMapper ORM and Data Modelling Engine",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/orm/issues",
        "source": "https://github.com/cycle/orm",
        "docs": "https://cycle-orm.dev/docs",
        "chat": "https://discord.gg/spiralphp"
    },
    "keywords": ["mysql", "mssql", "sqlite", "postgresql", "orm", "sql", "query-builder", "data-mapper"],
    "authors": [
        {
            "name": "Anton Titov (wolfy-j)",
            "email": "wolfy-j@spiralscout.com"
        },
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "email": "alexey.gagarin@spiralscout.com"
        },
        {
            "name": "Pavel Butchnev (butschster)",
            "email": "pavel.buchnev@spiralscout.com"
        },
        {
            "name": "Maksim Smakouz (msmakouz)",
            "email": "maksim.smakouz@spiralscout.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/cycle/testing"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.23",
        "doctrine/instantiator": "^2.0",
        "spiral/core": "^3.18"
    },
    "require-dev": {
        "ext-pdo": "*",
        "bamarni/composer-bin-plugin": "^1.9",
        "buggregator/trap": "^1.20",
        "cycle/testing": "^0.1.1",
        "doctrine/collections": "^2.6 || ^3.0",
        "illuminate/collections": "12 - 13",
        "llm/skills": "^1.20",
        "loophp/collection": "^7.6",
        "mockery/mockery": "^1.6",
        "ramsey/uuid": "^4.10",
        "roxblnfk/unpoly": "^1.8",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.60"
    },
    "suggest": {
        "llm/skills": "To sync the cycle-orm AI skill into your project"
    },
    "autoload": {
        "psr-4": {
            "Cycle\\ORM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\ORM\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "skills": {
            "sources": [
                {
                    "from": "github",
                    "package": "cycle/skills",
                    "skills": ["cycle-orm"]
                }
            ]
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "db:down": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml down -v",
        "db:up": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml up -d --wait",
        "test": "testo",
        "test:mysql": "testo --suite=Feature/MySQL --suite=Regression/MySQL",
        "test:postgres": "testo --suite=Feature/Postgres --suite=Regression/Postgres",
        "test:sqlite": "testo --suite=Feature/SQLite --suite=Regression/SQLite",
        "test:sqlserver": "testo --suite=Feature/SQLServer --suite=Regression/SQLServer",
        "test:unit": "testo --suite=Unit"
    }
}
